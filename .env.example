# Required: Neon owner/role allowed to create the application schema and tables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Optional schema; default is jn_story.
# DATABASE_SCHEMA=jn_story
# DATA_DIR is used only by npm run db:migrate to locate the old SQLite database.

# Required for production admin writes; must be the exact HTTPS origin.
# SITE_URL=https://your-real-domain

# Optional destination for npm run backup. Keep backups private.
# BACKUP_DIR=/backups
